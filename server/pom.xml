<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mini Project 2 - LLM-powered RESTful Web Service (English/any language -> Moroccan Darija)
  Student: Ali Beraouz (138123)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ma.aui.darija</groupId>
    <artifactId>darija-translator-service</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>Darija Translator REST Service</name>
    <description>Jakarta REST web service that translates text to Moroccan Darija using Google Gemini, secured with HTTP Basic authentication.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jakartaee.version>11.0.0</jakartaee.version>
        <!-- Embedded container: Payara Micro (Payara Community 7, Jakarta EE 11, needs JDK 21+) -->
        <payara.micro.version>7.2026.9</payara.micro.version>

        <junit.version>5.11.4</junit.version>
        <parsson.version>1.1.7</parsson.version>
    </properties>

    <dependencies>
        <!-- Jakarta EE 11 Web Profile APIs: REST, CDI, JSON-B/JSON-P, Security, Authentication, Servlet -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- JSON-P implementation so unit tests can run outside the container -->
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>${parsson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The WAR name is also the context root: http://localhost:8080/darija/... -->
        <finalName>darija</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- 1) Download the Payara Micro runtime into target/payara-micro.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-payara-micro</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>fish.payara.extras</groupId>
                                    <artifactId>payara-micro</artifactId>
                                    <version>${payara.micro.version}</version>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                    <destFileName>payara-micro.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2) Bundle the WAR + Payara Micro into one runnable "uber" JAR:
                    target/darija-microbundle.jar  (skip with -Dexec.skip=true) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>bundle-uber-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/payara-micro.jar</argument>
                                <argument>--deploy</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.war</argument>
                                <argument>--outputUberJar</argument>
                                <argument>${project.build.directory}/darija-microbundle.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
