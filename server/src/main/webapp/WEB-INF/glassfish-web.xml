<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
        "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<!--
    Payara/GlassFish deployment descriptor: maps the "translator-user" group returned by
    TranslatorIdentityStore to the "translator-user" role required in web.xml.
-->
<glassfish-web-app>
    <security-role-mapping>
        <role-name>translator-user</role-name>
        <group-name>translator-user</group-name>
    </security-role-mapping>
</glassfish-web-app>
